{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Zelda Notes",
  "version": "0.2.0",
  "identifier": "io.github.diefrttt.zeldanotes",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Zelda Notes",
        "url": "index.html",
        "width": 1240,
        "height": 820,
        "minWidth": 840,
        "minHeight": 560,
        "resizable": true
      },
      {
        "label": "overlay",
        "title": "Zelda Notes Overlay",
        "url": "overlay.html",
        "width": 276,
        "height": 290,
        "minWidth": 160,
        "minHeight": 140,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
